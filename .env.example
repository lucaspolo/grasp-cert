# Banco de dados PostgreSQL
# Padrão do docker-compose.yml: usuario=grasp, senha=grasp, banco=grasp_cert
DATABASE_URL="postgresql://grasp:grasp@localhost:5432/grasp_cert"

# NextAuth — segredo para assinar os tokens JWT
# Gere um novo com: openssl rand -base64 32
AUTH_SECRET="troque-em-producao"

# Criptografia em repouso dos secrets TOTP (2FA) — 32 bytes em base64
# Gere com: openssl rand -base64 32
# Sem esta variável os secrets são armazenados em claro (com aviso no log).
# Secrets legados em claro são migrados automaticamente no próximo uso.
TOTP_ENC_KEY=""

# URL pública da aplicação (usada em links de e-mail e certificados)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — serviço de envio de e-mails (reset de senha, verificação de e-mail)
# Obtenha sua chave em: https://resend.com
RESEND_API_KEY="re_..."

# Sentry — monitoramento de erros (só ativa com NODE_ENV=production)
# DSN do projeto em: Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
# Opcionais — usados apenas para upload de source maps no build
# (a integração Sentry↔Vercel preenche automaticamente em produção)
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# E-mail remetente (opcional — padrão: onboarding@resend.dev)
# RESEND_FROM_EMAIL="noreply@seudominio.com"
