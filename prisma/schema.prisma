generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  USER
}

// Cargo DENTRO de um grupo, independente do cargo global do usuário: um
// USER global pode ser ADMIN do seu grupo (e só dele).
enum GroupRole {
  ADMIN
  MEMBER
}

model User {
  id             String          @id @default(uuid())
  callsign       String          @unique
  email          String          @unique
  name           String
  city           String
  state          String
  role           Role            @default(USER)
  passwordHash   String          @map("password_hash")
  // Incrementada no reset de senha: tokens JWT emitidos com versão anterior
  // são invalidados na próxima revalidação (src/lib/jwt-refresh.ts).
  sessionVersion Int             @default(0) @map("session_version")
  emailVerified  DateTime?       @map("email_verified")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  assignedEvents EventOperator[]
  groupMemberships GroupMember[]
  twoFactor      TwoFactorAuth?
  recoveryCodes  TwoFactorRecoveryCode[]
  trustedDevices TrustedDevice[]

  @@map("users")
}

// Clube/entidade que organiza eventos. Cada grupo tem seus próprios admins,
// templates e eventos; o cargo global OWNER/ADMIN enxerga todos os grupos.
model Group {
  id          String   @id @default(uuid())
  name        String   @unique
  /** Indicativo do clube, quando existe (ex.: PY2AA). Só informativo. */
  callsign    String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members   GroupMember[]
  events    Event[]
  templates Template[]

  @@map("groups")
}

model GroupMember {
  id        String    @id @default(uuid())
  groupId   String    @map("group_id")
  userId    String    @map("user_id")
  role      GroupRole @default(MEMBER)
  createdAt DateTime  @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model TwoFactorAuth {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  secret       String
  enabled      Boolean   @default(false)
  // Último timestep TOTP aceito — códigos deste passo ou anteriores são
  // rejeitados (anti-replay, RFC 6238 §5.2).
  lastUsedStep Int?      @map("last_used_step")
  confirmedAt  DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

model TrustedDevice {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  label      String?
  expires    DateTime
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_trusted_devices")
}

// Contadores de rate limiting (janela fixa + lockout). Vivem no Postgres
// porque o app roda em serverless (Vercel): memória local não é compartilhada
// entre instâncias. Linhas expiradas são limpas oportunisticamente.
model RateLimit {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime  @map("window_start")
  lockedUntil DateTime? @map("locked_until")

  @@index([windowStart])
  @@map("rate_limits")
}

// Trilha de auditoria de ações administrativas. Sem FK para User de
// propósito: o registro deve sobreviver à exclusão do usuário que agiu.
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  actorCallsign String   @map("actor_callsign")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  summary       String
  details       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Template {
  id         String   @id @default(uuid())
  name       String
  // Null = template GLOBAL da plataforma, disponível para qualquer grupo e
  // gerenciado só pelo OWNER. É o caso do "Padrão", usado como fallback por
  // evento sem template — por isso a coluna é opcional.
  groupId    String?  @map("group_id")
  bgImage    Bytes?   @map("bg_image")
  bgMimeType String?  @map("bg_mime_type")
  config     Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  group  Group?  @relation(fields: [groupId], references: [id])
  events Event[]

  @@index([groupId])
  @@map("templates")
}

model Event {
  id           String    @id @default(uuid())
  name         String
  // Obrigatório: todo evento pertence a um grupo, que define quem o
  // administra e quais templates ele pode usar.
  groupId      String    @map("group_id")
  startDate    DateTime  @map("start_date")
  endDate      DateTime  @map("end_date")
  templateId   String?   @map("template_id")
  observations String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  group     Group           @relation(fields: [groupId], references: [id])
  template  Template?       @relation(fields: [templateId], references: [id])
  qsos      QSO[]
  operators EventOperator[]
  eventBands EventBand[]
  eventModes EventMode[]

  @@index([groupId])
  @@map("events")
}

model QSO {
  id                  String   @id @default(uuid())
  eventId             String   @map("event_id")
  participantCallsign String   @map("participant_callsign")
  operatorCallsign    String?  @map("operator_callsign")
  dateTime            DateTime @map("date_time")
  frequency           String
  bandId              String   @map("band_id")
  modeId              String   @map("mode_id")
  rstSent             String   @map("rst_sent")
  rstReceived         String   @map("rst_received")
  observations        String?
  createdAt           DateTime @default(now()) @map("created_at")

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  band    Band  @relation(fields: [bandId], references: [id])
  modeRef Mode  @relation(fields: [modeId], references: [id])

  // Um mesmo contato (indicativo, horário, banda, modo) não pode ser lançado
  // duas vezes no mesmo evento — protege digitação manual e importação ADIF.
  @@unique([eventId, participantCallsign, dateTime, bandId, modeId])
  @@map("qsos")
}

model EventOperator {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_operators")
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("email_verification_tokens")
}

model Band {
  id        String   @id @default(uuid())
  name      String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  eventBands EventBand[]
  qsos       QSO[]

  @@map("bands")
}

model Mode {
  id        String   @id @default(uuid())
  name      String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  eventModes EventMode[]
  qsos       QSO[]

  @@map("modes")
}

model EventBand {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  bandId  String @map("band_id")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  band  Band  @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@unique([eventId, bandId])
  @@map("event_bands")
}

model EventMode {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  modeId  String @map("mode_id")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mode  Mode  @relation(fields: [modeId], references: [id], onDelete: Cascade)

  @@unique([eventId, modeId])
  @@map("event_modes")
}
